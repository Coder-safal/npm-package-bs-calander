{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@coder-safal/bs-calendar": ["src/index.ts"], "@coder-safal/bs-calendar/core": ["src/core/index.ts"], "@coder-safal/bs-calendar/react": ["src/react.ts"] }
  },
  "include": ["src", "tests", "examples/vite", "tsup.config.ts", "vitest.config.ts"]
}
